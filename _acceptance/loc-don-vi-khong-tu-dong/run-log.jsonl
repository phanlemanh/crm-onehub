"{\"ts\":\"2026-10-21T12:34:07Z\",\"sha\":\"e67b69563fbb95b175d5b17f2dcdb9e7eb9ba696\",\"round\":1,\"kind\":\"finding\",\"file\":\"packages/ui/src/components/data-table.tsx\",\"title\":\"DataTable bọc bảng trong VungDangTai làm hỏng bố cục layout=\\\"fill\\\" (mặc định) khi có refreshing\",\"severity\":\"medium\",\"source\":\"conventions\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Chưa màn nào bị ảnh hưởng. Nếu sau này một màn khác dùng bảng kiểu lấp đầy chỗ trống và bật chế độ làm mờ khi tải lại, bảng có thể mất thanh cuộn riêng và mất tiêu đề dính, cả trang bị tràn.\",\"can_cu\":\"Hiện chỉ trang Theo đơn vị dùng tính năng này và nó không dính lỗi, nên người dùng chưa thấy gì; lỗi chỉ hiện khi có màn mới và người làm màn đó thấy ngay khi dựng, sửa lúc đó rẻ.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
