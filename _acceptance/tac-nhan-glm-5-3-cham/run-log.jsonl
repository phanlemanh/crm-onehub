"{\"ts\":\"2026-10-16T17:01:56Z\",\"sha\":\"1f906a4fa4aba3afe4507134450f8131c57f64db\",\"round\":1,\"kind\":\"finding\",\"file\":\"_acceptance/tac-nhan-glm-5-3-cham/rang/do-tac-nhan.ts\",\"title\":\"do-tac-nhan.ts sửa tạm tệp sản phẩm đang theo dõi mà không bắt tín hiệu ngắt, trái nếp của chính helper nó dùng\",\"severity\":\"medium\",\"source\":\"conventions\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Nếu người chạy bài đo bấm dừng giữa chừng, một tệp sản phẩm có thể bị để lại ở bản sửa tạm và kho dữ liệu đo không được dọn. Người dùng sản phẩm không bị ảnh hưởng, chỉ người chạy đo phải tự hoàn lại.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
