{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "const": "nhatot"
    },
    "crawledAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "items": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 500,
            "format": "uri"
          },
          "shopName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "personName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "isCompany": {
            "type": "boolean"
          },
          "hasLicense": {
            "type": "boolean"
          },
          "districts": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "city": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "listingsTotal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "listingsNew30d": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "tier": {
            "type": "string",
            "enum": [
              "cao",
              "vua",
              "thap",
              "ngu"
            ]
          },
          "phone": {
            "type": "string",
            "minLength": 6,
            "maxLength": 30
          }
        },
        "required": [
          "url",
          "shopName",
          "isCompany",
          "hasLicense",
          "districts",
          "city",
          "listingsTotal",
          "listingsNew30d",
          "tier"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "source",
    "crawledAt",
    "items"
  ],
  "additionalProperties": false
}
