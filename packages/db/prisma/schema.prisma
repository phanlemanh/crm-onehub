  muonLam    String
  daXayRa    String
  tieuDe     String
  man        String
  guiLuc     DateTime    @default(now())
  keoVeLuc   DateTime?

  @@index([nguoiGuiId, guiLuc])
  @@map("tinHieu")
}

enum TrangThaiViec {
  CHUA_LAM
  DANG_LAM
  CHO_DANH_GIA
  XONG
  HUY
}

model Viec {
  id              String        @id @default(cuid())
  tieuDe          String
  moTa            String?
  trangThai       TrangThaiViec @default(CHUA_LAM)
  hanNgay         DateTime?
  nguoiGiaoId     String
  nguoiGiao       User          @relation("ViecNguoiGiao", fields: [nguoiGiaoId], references: [id], onDelete: Restrict)
  nguoiThucHienId String
  nguoiThucHien   User          @relation("ViecNguoiThucHien", fields: [nguoiThucHienId], references: [id], onDelete: Restrict)
  taoBoiId        String
  taoBoi          User          @relation("ViecTaoBoi", fields: [taoBoiId], references: [id], onDelete: Restrict)
  taoLuc          DateTime      @default(now())
  doiLuc          DateTime      @updatedAt
  roiChuaLamLuc   DateTime?
  khepLuc         DateTime?
  activityGocId   String?       @unique
  activityGoc     Activity?     @relation("ViecChep", fields: [activityGocId], references: [id], onDelete: SetNull)
  khoaNguon       String?
  gan             ViecGan[]
  theoDoi         ViecTheoDoi[]
  vet             ViecVet[]
  chaId           String?
  cha             Viec?         @relation("ViecCon", fields: [chaId], references: [id], onDelete: NoAction)
  con             Viec[]        @relation("ViecCon")
  thuTu           ViecThuTu[]

  @@index([chaId])
  @@index([nguoiThucHienId, trangThai, hanNgay])
  @@index([nguoiGiaoId, trangThai])
  @@index([taoLuc])
  @@index([khoaNguon])
  @@map("viec")
}

model ViecGan {
  id        String          @id @default(cuid())
  viecId    String
  viec      Viec            @relation(fields: [viecId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact?        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  planId    String?
  plan      OnboardingPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  taoLuc    DateTime        @default(now())

  @@unique([viecId, companyId])
  @@unique([viecId, contactId])
  @@unique([viecId, dealId])
  @@unique([viecId, planId])
  @@index([companyId])
  @@index([contactId])
  @@index([dealId])
  @@index([planId])
  @@map("viecGan")
}

model ViecTheoDoi {
  id     String   @id @default(cuid())
  viecId String
  viec   Viec     @relation(fields: [viecId], references: [id], onDelete: Cascade)
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taoLuc DateTime @default(now())

  @@unique([viecId, userId])
  @@index([userId])
  @@map("viecTheoDoi")
}

model ViecVet {
  id      String   @id @default(cuid())
  viecId  String
  viec    Viec     @relation(fields: [viecId], references: [id], onDelete: Cascade)
  luc     DateTime @default(now())
  nguoiId String?
  nguoi   User?    @relation("ViecVetNguoi", fields: [nguoiId], references: [id], onDelete: SetNull)
  loai    String
  truoc   Json?
  sau     Json?
  nguon   String

  @@index([viecId, luc])
  @@index([loai])
  @@map("viecVet")
}

model ThongBao {
  id          String    @id @default(cuid())
  nguoiNhanId String
  nguoiNhan   User      @relation("ThongBaoNguoiNhan", fields: [nguoiNhanId], references: [id], onDelete: Cascade)
  nguon       String
  khoa        String
  noiDung     Json
  duongDan    String
  taoLuc      DateTime  @default(now())
  ngayDau     String
  thayNgay    String
  docLuc      DateTime?
  moLuc       DateTime?

  @@unique([nguoiNhanId, khoa, ngayDau])
  @@index([nguoiNhanId, taoLuc])
  @@index([nguoiNhanId, docLuc])
  @@index([taoLuc])
  @@map("thongBao")
}

model ViecThuTu {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viecId String
  viec   Viec     @relation(fields: [viecId], references: [id], onDelete: Cascade)
  khoa   String
  doiLuc DateTime @updatedAt

  @@unique([userId, viecId])
  @@index([userId])
  @@map("viecThuTu")
}
