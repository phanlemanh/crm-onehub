model ZaloLink {
  id              String   @id @default(cuid())
  crmUserId       String   @unique
  crmUser         User     @relation(fields: [crmUserId], references: [id], onDelete: Cascade)
  zaloUserId      String   @unique
  zaloDisplayName String
  linkedAt        DateTime @default(now())

  @@map("zaloLink")
}

model ZaloLinkCode {
  id        String    @id @default(cuid())
  crmUserId String    @unique
  crmUser   User      @relation(fields: [crmUserId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("zaloLinkCode")
}

model ZaloLinkAttempt {
  zaloUserId      String   @id
  failures        Int      @default(0)
  windowStartedAt DateTime

  @@map("zaloLinkAttempt")
}

model ZaloUpdateSeen {
  messageId String   @id
  seenAt    DateTime @default(now())

  @@index([seenAt])
  @@map("zaloUpdateSeen")
}

model ZaloHoi {
  id         String    @id @default(cuid())
  messageId  String    @unique
  crmUserId  String
  zaloChatId String
  sessionId  String?
  hoiLuc     DateTime  @default(now())
  traLoiLuc  DateTime?
  doTreMs    Int?
  tokenVao   Int?
  tokenRa    Int?
  ketQua     String

  @@index([crmUserId, hoiLuc])
  @@index([zaloChatId, ketQua])
  @@index([hoiLuc])
  @@map("zaloHoi")
}

model NotificationPreference {
  id           String              @id @default(cuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel      NotificationChannel @default(AUTO)
  dongTroLyOkr Boolean             @default(true)
  updatedAt    DateTime            @updatedAt

  @@map("notificationPreference")
}

model OnboardingStep {
  id     String         @id @default(cuid())
  planId String
  plan   OnboardingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  label        String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  assigneeId String?
  assignee   User?   @relation("OnboardingStepAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  dueAt       DateTime
  completedAt DateTime?
  position    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId, position])
  @@index([departmentId])
  @@index([assigneeId])
  @@index([completedAt])
  @@map("onboardingStep")
}

model OnboardingEnrollment {
  id     String         @id @default(cuid())
  planId String
  plan   OnboardingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  accountAt DateTime?
  courseAt  DateTime?
  activeAt  DateTime?
  dealAt    DateTime?

  source String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, contactId])
  @@index([planId])
  @@index([contactId])
  @@map("onboardingEnrollment")
}

model OkrCycle {
  id            String         @id @default(cuid())
  kind          String
  name          String
  parentId      String?
  parent        OkrCycle?      @relation("OkrCycleParent", fields: [parentId], references: [id], onDelete: Restrict)
  children      OkrCycle[]     @relation("OkrCycleParent")
  startsOn      DateTime       @db.Date
  endsOn        DateTime       @db.Date
  phase         String         @default("lap-ke-hoach")
  breakStartsOn DateTime?      @db.Date
  breakEndsOn   DateTime?      @db.Date
  updateWeekday Int            @default(1)
  anLuc         DateTime?
  objectives    OkrObjective[]
  cuaSoRa       OkrCuaSoRa[]
  diemKr        OkrDiemKr[]
  mangSangToi   OkrMangSang[]
  hoiY          OkrHoiY?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([parentId])
  @@index([startsOn])
  @@index([anLuc])
  @@map("okrCycle")
}

model OkrProgramConfig {
  id                   String   @id @default(cuid())
  version              Int      @unique
  objectiveCap         Int
  krCap                Int
  capMode              String
  scoreScale           String
  weightsOn            Boolean
  personalOn           Boolean
  aiOn                 Boolean  @default(false)
  aiDeXuatPhamVi       String   @default("tat")
  aiDeXuatDonVi        String[] @default([])
  aiTomTatPhamVi       String   @default("tat")
  aiTomTatDonVi        String[] @default([])
  aiDeXuatAnPhamVi     String   @default("tat")
  aiDeXuatAnDonVi      String[] @default([])
  aiTomTatAnPhamVi     String   @default("tat")
  aiTomTatAnDonVi      String[] @default([])
  aiTranThangUsd       Decimal  @default(9) @db.Decimal(8, 2)
  duyetCongBo          Boolean  @default(false)
  aiSoanPhamVi         String   @default("tat")
  aiSoanDonVi          String[] @default([])
  aiSoanAnPhamVi       String   @default("tat")
  aiSoanAnDonVi        String[] @default([])
  aiTranThangDatOkrUsd Decimal? @db.Decimal(8, 2)
  createdById          String
  createdAt            DateTime @default(now())

  @@map("okrProgramConfig")
}

model OkrObjective {
  id           String           @id @default(cuid())
  cycleId      String
  cycle        OkrCycle         @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  level        String
  divisionId   String?
  division     Division?        @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  departmentId String?
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  personUserId String?
  person       User?            @relation("OkrObjectivePerson", fields: [personUserId], references: [id], onDelete: Restrict)
  ownerUserId  String
  owner        User             @relation("OkrObjectiveOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  kind         String
  status       String           @default("nhap")
  hienThi      String           @default("cong-khai")
  title        String
  whyNow       String           @default("")
  publishedAt  DateTime?
  droppedAt    DateTime?
  position     Int              @default(0)
  participants OkrParticipant[]
  keyResults   OkrKeyResult[]
  alignments   OkrAlignment[]   @relation("OkrAlignmentSource")
  alignedBy    OkrAlignment[]   @relation("OkrAlignmentTargetObjective")
  comments     OkrComment[]
  followers    OkrFollow[]
  nhinLai      OkrNhinLai?
  mangSangDi   OkrMangSang[]    @relation("OkrMangSangTu")
  mangSangTu   OkrMangSang?     @relation("OkrMangSangSang")
  ghiNhan      OkrGhiNhan[]
  mucTieuTuMau OkrMucTieuTuMau?
  chuDeHoiY    OkrChuDe?
  nguoiXem     OkrNguoiXem[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([cycleId, level])
  @@index([cycleId, hienThi])
  @@index([divisionId])
  @@index([departmentId])
  @@index([personUserId])
  @@index([ownerUserId])
  @@map("okrObjective")
}

model OkrParticipant {
  objectiveId String
  objective   OkrObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@id([objectiveId, userId])
  @@index([userId])
  @@map("okrParticipant")
}

model OkrKeyResult {
  id            String         @id @default(cuid())
  objectiveId   String
  objective     OkrObjective   @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  title         String
  kind          String
  ownerUserId   String
  owner         User           @relation("OkrKeyResultOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  startValue    Decimal        @db.Decimal(18, 4)
  targetValue   Decimal        @db.Decimal(18, 4)
  currentValue  Decimal        @db.Decimal(18, 4)
  unit          String         @default("")
  dueOn         DateTime?      @db.Date
  weight        Decimal        @default(1) @db.Decimal(6, 2)
  source        String         @default("tay")
  startLockedAt DateTime?
  position      Int            @default(0)
  alignedBy     OkrAlignment[] @relation("OkrAlignmentTargetKeyResult")
  checkIns      OkrCheckIn[]
  comments      OkrComment[]
  nguonMay      OkrNguonKr?
  soChup        OkrSoChup[]
  doiDich       OkrDoiDich[]
  diemKr        OkrDiemKr?
  viecKr        OkrViecKr[]
  bangChung     OkrBangChung[]
  ghiNhan       OkrGhiNhan[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([objectiveId, position])
  @@index([ownerUserId])
  @@map("okrKeyResult")
}

model OkrAlignment {
  id                String        @id @default(cuid())
  objectiveId       String
  objective         OkrObjective  @relation("OkrAlignmentSource", fields: [objectiveId], references: [id], onDelete: Cascade)
  targetObjectiveId String?
  targetObjective   OkrObjective? @relation("OkrAlignmentTargetObjective", fields: [targetObjectiveId], references: [id], onDelete: Cascade)
  targetKeyResultId String?
  targetKeyResult   OkrKeyResult? @relation("OkrAlignmentTargetKeyResult", fields: [targetKeyResultId], references: [id], onDelete: Cascade)
  lyDo              String?
  canCu             String?
  lyDoTuKara        Boolean       @default(false)
  createdAt         DateTime      @default(now())

  @@unique([objectiveId, targetObjectiveId, targetKeyResultId])
  @@index([targetObjectiveId])
  @@index([targetKeyResultId])
  @@map("okrAlignment")
}

model OkrTrail {
  id          String   @id @default(cuid())
  at          DateTime @default(now())
  actorUserId String
  cycleId     String?
  objectiveId String?
  keyResultId String?
  action      String
  before      Json?
  after       Json?
  note        String?

  @@index([objectiveId, at])
  @@index([cycleId, at])
  @@index([at])
  @@map("okrTrail")
}

model OkrCheckInSession {
  id          String       @id @default(cuid())
  userId      String
  entry       String
  openedAt    DateTime     @default(now())
  submittedAt DateTime?
  seconds     Int?
  checkIns    OkrCheckIn[]

  @@index([userId, openedAt])
  @@index([submittedAt])
  @@map("okrCheckInSession")
}

model OkrCheckIn {
  id           String            @id @default(cuid())
  keyResultId  String
  keyResult    OkrKeyResult      @relation(fields: [keyResultId], references: [id], onDelete: Restrict)
  sessionId    String
  session      OkrCheckInSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  weekStart    DateTime          @db.Date
  value        Decimal           @db.Decimal(18, 4)
  confidence   String
  note         String            @default("")
  authorUserId String
  ownerUserId  String
  onBehalf     Boolean           @default(false)
  channel      String            @default("web")
  createdAt    DateTime          @default(now())

  @@index([keyResultId, createdAt])
  @@index([weekStart])
  @@index([authorUserId])
  @@map("okrCheckIn")
}

model OkrComment {
  id           String        @id @default(cuid())
  objectiveId  String
  objective    OkrObjective  @relation(fields: [objectiveId], references: [id], onDelete: Restrict)
  keyResultId  String?
  keyResult    OkrKeyResult? @relation(fields: [keyResultId], references: [id], onDelete: SetNull)
  body         String
  authorUserId String
  createdAt    DateTime      @default(now())
  mentions     OkrMention[]

  @@index([objectiveId, createdAt])
  @@index([createdAt])
  @@map("okrComment")
}

model OkrMention {
  commentId String
  comment   OkrComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String

  @@id([commentId, userId])
  @@index([userId])
  @@map("okrMention")
}

model OkrFollow {
  objectiveId String
  objective   OkrObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  userId      String
  createdAt   DateTime     @default(now())

  @@id([objectiveId, userId])
  @@index([userId])
  @@map("okrFollow")
}

model OkrNguonKr {
  id           String       @id @default(cuid())
  keyResultId  String       @unique
  keyResult    OkrKeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  loai         String
  chiSo        String?
  phamVi       Json?
  bac          String?
  sheetId      String?
  sheetO       String?
  docLuc       DateTime?
  docGiaTri    Decimal?     @db.Decimal(18, 4)
  docLoi       String?
  thuLuc       DateTime?
  taoBoiUserId String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([loai])
  @@map("okrNguonKr")
}

model OkrSoChup {
  id           String       @id @default(cuid())
  keyResultId  String
  keyResult    OkrKeyResult @relation(fields: [keyResultId], references: [id], onDelete: Restrict)
  ngay         DateTime     @db.Date
  giaTri       Decimal      @db.Decimal(18, 4)
  nguon        String
  chiSo        String?
  phamVi       Json?
  bac          String?
  tacGiaUserId String?
  chupLuc      DateTime     @default(now())

  @@unique([keyResultId, ngay], map: "okrSoChup_may_mot_ngay", where: raw("nguon = ANY (ARRAY['crm'::text, 'bang-tinh'::text])"))
  @@index([keyResultId, ngay])
  @@map("okrSoChup")
}

model TaiLieuTrang {
  id            String                   @id @default(cuid())
  slug          String                   @unique
  ten           String
  loai          String
  departmentId  String?
  department    Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  chuTrangId    String
  chuTrang      User                     @relation("TaiLieuChuTrang", fields: [chuTrangId], references: [id], onDelete: Restrict)
  xacMinhDen    DateTime?
  banDangDungId String?                  @unique
  banDangDung   TaiLieuPhienBan?         @relation("TaiLieuBanDangDung", fields: [banDangDungId], references: [id], onDelete: Restrict)
  timKiem       Unsupported("tsvector")?
  archivedAt    DateTime?
  taoBoiId      String
  taoBoi        User                     @relation("TaiLieuTaoBoi", fields: [taoBoiId], references: [id], onDelete: Restrict)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  phienBan      TaiLieuPhienBan[]        @relation("TaiLieuPhienBanCuaTrang")
  deXuat        TaiLieuDeXuat[]
  suKien        TaiLieuSuKien[]
  lienKet       TaiLieuLienKet[]
  nguon         TaiLieuNguon[]           @relation("TaiLieuNguonCuaTrang")
  baoSai        TaiLieuBaoSai[]

  @@index([loai])
  @@index([chuTrangId])
  @@index([timKiem], type: Gin)
  @@index([archivedAt])
  @@map("taiLieuTrang")
}

model TaiLieuPhienBan {
  id          String          @id @default(cuid())
  trangId     String
  trang       TaiLieuTrang    @relation("TaiLieuPhienBanCuaTrang", fields: [trangId], references: [id], onDelete: Restrict)
  so          Int
  ten         String
  noiDung     String
  noiDungHash String
  deXuatId    String          @unique
  deXuat      TaiLieuDeXuat   @relation("TaiLieuPhienBanTuDeXuat", fields: [deXuatId], references: [id], onDelete: Restrict)
  duyetBoiId  String
  duyetBoi    User            @relation("TaiLieuDuyetBoi", fields: [duyetBoiId], references: [id], onDelete: Restrict)
  duyetLuc    DateTime
  dangDungO   TaiLieuTrang?   @relation("TaiLieuBanDangDung")
  laBanGocCua TaiLieuDeXuat[] @relation("TaiLieuDeXuatBanGoc")

  @@unique([trangId, so])
  @@map("taiLieuPhienBan")
}

model TaiLieuDeXuat {
  id           String           @id @default(cuid())
  trangId      String
  trang        TaiLieuTrang     @relation(fields: [trangId], references: [id], onDelete: Restrict)
  banGocId     String?
  banGoc       TaiLieuPhienBan? @relation("TaiLieuDeXuatBanGoc", fields: [banGocId], references: [id], onDelete: Restrict)
  ten          String
  noiDung      String
  taoBoiId     String
  taoBoi       User             @relation("TaiLieuDeXuatTaoBoi", fields: [taoBoiId], references: [id], onDelete: Restrict)
  trangThai    String           @default("CHO_DUYET")
  loai         String           @default("NOI_DUNG")
  tuPhienBanSo Int?
  lyDoDeXuat   String?
  lyDo         String?
  xuLyBoiId    String?
  xuLyBoi      User?            @relation("TaiLieuDeXuatXuLyBoi", fields: [xuLyBoiId], references: [id], onDelete: SetNull)
  xuLyLuc      DateTime?
  createdAt    DateTime         @default(now())
  phienBan     TaiLieuPhienBan? @relation("TaiLieuPhienBanTuDeXuat")
  nguonId      String?
  nguon        TaiLieuNguon?    @relation(fields: [nguonId], references: [id], onDelete: Restrict)
  trichDoan    Json?

  @@index([trangId, trangThai])
  @@index([nguonId])
  @@map("taiLieuDeXuat")
}

model TaiLieuNguon {
  id           String          @id @default(cuid())
  sha256       String          @unique
  tenTep       String
  kieu         String
  kichThuoc    Int
  blobPathname String          @unique
  taiBoiId     String
  taiBoi       User            @relation("TaiLieuNguonTaiBoi", fields: [taiBoiId], references: [id], onDelete: Restrict)
  taiLuc       DateTime        @default(now())
  trangId      String
  trang        TaiLieuTrang    @relation("TaiLieuNguonCuaTrang", fields: [trangId], references: [id], onDelete: Restrict)
  trangThai    String          @default("CHO_DOC")
  lyDo         String?
  chu          String?
  soTrang      Int?
  soanLuc      DateTime?
  banGocId     String?
  phienId      String?
  deXuat       TaiLieuDeXuat[]

  @@index([trangId])
  @@index([taiBoiId])
  @@index([phienId])
  @@map("taiLieuNguon")
}

model TaiLieuSuKien {
  id      String       @id @default(cuid())
  trangId String
  trang   TaiLieuTrang @relation(fields: [trangId], references: [id], onDelete: Restrict)
  loai    String
  aiId    String
  ai      User         @relation("TaiLieuSuKienAi", fields: [aiId], references: [id], onDelete: Restrict)
  luc     DateTime     @default(now())
  chiTiet Json

  @@index([trangId, luc])
  @@map("taiLieuSuKien")
}

model TaiLieuLienKet {
  id        String       @id @default(cuid())
  tuTrangId String
  tuTrang   TaiLieuTrang @relation(fields: [tuTrangId], references: [id], onDelete: Cascade)
  denSlug   String
  vanBan    String

  @@index([denSlug])
  @@index([tuTrangId])
  @@map("taiLieuLienKet")
}

model TaiLieuHoi {
  id         String          @id @default(cuid())
  nguoiHoiId String
  nguoiHoi   User            @relation("TaiLieuHoiNguoiHoi", fields: [nguoiHoiId], references: [id], onDelete: Restrict)
  kenh       String
  zaloHoiId  String?         @unique
  phienId    String?
  cauHoi     String?
  trangThai  String          @default("DANG_HOI")
  lyDo       String?
  traLoi     Json?
  ganNhat    Json?
  hoiLuc     DateTime        @default(now())
  xongLuc    DateTime?
  tokenVao   Int             @default(0)
  tokenRa    Int             @default(0)
  chiPhiUsd  Float           @default(0)
  soLanBac   Int             @default(0)
  nhanKhoa   String?
  xuLyLuc    DateTime?
  xuLyBoiId  String?
  xuLyBoi    User?           @relation("TaiLieuHoiXuLyBoi", fields: [xuLyBoiId], references: [id], onDelete: Restrict)
  baoSai     TaiLieuBaoSai[]

  @@index([nguoiHoiId, hoiLuc])
  @@index([kenh, hoiLuc])
  @@index([phienId, trangThai])
  @@index([trangThai, hoiLuc])
  @@map("taiLieuHoi")
}

model TaiLieuBaoSai {
  id         String       @id @default(cuid())
  hoiId      String
  hoi        TaiLieuHoi   @relation(fields: [hoiId], references: [id], onDelete: Restrict)
  trangId    String
  trang      TaiLieuTrang @relation(fields: [trangId], references: [id], onDelete: Restrict)
  phienBan   Int
  nguoiBaoId String
  nguoiBao   User         @relation("TaiLieuBaoSaiNguoiBao", fields: [nguoiBaoId], references: [id], onDelete: Restrict)
  cauHoi     String
  ghiChu     String?
  trangThai  String       @default("MO")
  ketLuan    String?
  xuLyLuc    DateTime?
  xuLyBoiId  String?
  xuLyBoi    User?        @relation("TaiLieuBaoSaiXuLyBoi", fields: [xuLyBoiId], references: [id], onDelete: Restrict)
  taoLuc     DateTime     @default(now())

  @@unique([hoiId, nguoiBaoId, trangId])
  @@index([trangId, trangThai])
  @@map("taiLieuBaoSai")
}

model OkrCuaSoRa {
  id            String       @id @default(cuid())
  cycleId       String
  cycle         OkrCycle     @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  tuNgay        DateTime     @db.Date
  denNgay       DateTime     @db.Date
  moBoiUserId   String
  dongLuc       DateTime?
  dongBoiUserId String?
  doiDich       OkrDoiDich[]
  createdAt     DateTime     @default(now())

  @@index([cycleId])
  @@map("okrCuaSoRa")
}

model OkrDoiDich {
  id           String       @id @default(cuid())
  keyResultId  String
  keyResult    OkrKeyResult @relation(fields: [keyResultId], references: [id], onDelete: Restrict)
  truoc        Decimal      @db.Decimal(18, 4)
  sau          Decimal      @db.Decimal(18, 4)
  lyDo         String       @default("")
  ngoaiRa      Boolean
  cuaSoRaId    String?
  cuaSoRa      OkrCuaSoRa?  @relation(fields: [cuaSoRaId], references: [id], onDelete: Restrict)
  tacGiaUserId String
  luc          DateTime     @default(now())

  @@index([keyResultId, luc])
  @@map("okrDoiDich")
}

model OkrDiemKr {
  id                  String       @id @default(cuid())
  keyResultId         String       @unique
  keyResult           OkrKeyResult @relation(fields: [keyResultId], references: [id], onDelete: Restrict)
  cycleId             String
  cycle               OkrCycle     @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  soChot              Decimal      @db.Decimal(18, 4)
  diemGoiY            Decimal      @db.Decimal(3, 2)
  diem                Decimal?     @db.Decimal(3, 2)
  lyDo                String?
  thang               String
  trongSoBat          Boolean
  phienBanChuongTrinh Int
  chamBoiUserId       String?
  chamLuc             DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([cycleId])
  @@map("okrDiemKr")
}

model OkrNhinLai {
  id           String       @id @default(cuid())
  objectiveId  String       @unique
  objective    OkrObjective @relation(fields: [objectiveId], references: [id], onDelete: Restrict)
  dieuHocDuoc  String
  suaBoiUserId String
  suaLuc       DateTime     @updatedAt

  @@map("okrNhinLai")
}

model OkrMangSang {
  id              String       @id @default(cuid())
  tuObjectiveId   String
  tuObjective     OkrObjective @relation("OkrMangSangTu", fields: [tuObjectiveId], references: [id], onDelete: Restrict)
  sangObjectiveId String       @unique
  sangObjective   OkrObjective @relation("OkrMangSangSang", fields: [sangObjectiveId], references: [id], onDelete: Restrict)
  sangCycleId     String
