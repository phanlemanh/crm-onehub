{
	"name": "crm",
	"private": true,
	"license": "MIT",
	"version": "1.15.3",
	"scripts": {
		"prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"lint:slop": "oxlint --format=default",
		"lint:dead": "knip --no-progress",
		"format": "biome format --write .",
		"check-types": "turbo run check-types",
		"test": "bun packages/db/scripts/test-run.ts",
		"auth:generate": "turbo run auth:generate",
		"db:deploy": "turbo run db:deploy",
		"db:generate": "turbo run db:generate",
		"db:migrate": "turbo run db:migrate",
		"db:push": "turbo run db:push",
		"db:reset": "turbo run db:reset",
		"db:seed": "turbo run db:seed",
		"db:studio": "turbo run db:studio",
		"db:test": "bun run --filter=@crm/db db:test",
		"db:do": "bun run --filter=@crm/db db:do",
		"do:man": "bun scripts/lan-do/phien-do.mjs",
		"okr:mau": "bun run --filter=api okr:mau",
		"ui:capture": "node scripts/ui-capture.mjs",
		"test:dieu-phoi": "node --test \"scripts/dieu-phoi/test/*.test.mjs\""
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@oxlint/plugins": "1.78.0",
		"@types/jsdom": "^30.0.0",
		"jsdom": "^30.0.1",
		"knip": "6.32.2",
		"oxlint": "1.78.0",
		"puppeteer-core": "^25.9.0",
		"turbo": "^2.10.8",
		"typescript": "5.9.2"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "bun@1.3.12",
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.3.12"
		}
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"patchedDependencies": {
		"@better-auth/api-key@1.6.25": "patches/@better-auth%2Fapi-key@1.6.25.patch"
	}
}
