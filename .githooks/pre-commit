#!/usr/bin/env bash

[ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ] || exit 0

CAY="$(git rev-parse --show-toplevel)"
HOOK_CAY="$CAY/.githooks/pre-commit"
if [ -f "$HOOK_CAY" ] && [ "$(realpath "$0")" != "$(realpath "$HOOK_CAY")" ]; then
	exec bash "$HOOK_CAY" "$@"
fi

[ -f "$CAY/scripts/trang-ve-gop.mjs" ] || exit 0
node "$CAY/scripts/trang-ve-gop.mjs" trong-gop
exit 0
