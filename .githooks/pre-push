#!/usr/bin/env sh

set -eu

if [ -n "${CRM_SKIP_HOOKS:-}" ]; then
	echo "pre-push: CRM_SKIP_HOOKS is set, so nothing was checked before this push."
	exit 0
fi

deleting_only=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
	case "$local_sha" in
	0000000000000000000000000000000000000000) ;;
	*) deleting_only=0 ;;
	esac
done
[ "$deleting_only" = "1" ] && exit 0

fail() {
	echo ""
	echo "  \`bun run $1\` failed, so this push would have failed CI."
	echo "  Fix it, or push anyway with --no-verify."
	echo ""
	exit 1
}

export TURBO_FORCE=true

for task in check-types lint lint:slop test; do
	echo "pre-push: bun run $task"
	bun run "$task" || fail "$task"
done
