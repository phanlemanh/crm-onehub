#!/usr/bin/env bash

set -euo pipefail

if [ -n "${CRM_SKIP_HOOKS:-}" ]; then
	echo "pre-push: CRM_SKIP_HOOKS is set, so nothing was checked before this push."
	exit 0
fi

CAY="$(git rev-parse --show-toplevel)"
HOOK_CAY="$CAY/.githooks/pre-push"
if [ -f "$HOOK_CAY" ] && [ "$(realpath "$0")" != "$(realpath "$HOOK_CAY")" ]; then
	echo "pre-push: running this tree's own hook at $HOOK_CAY"
	exec bash "$HOOK_CAY" "$@"
fi

deleting_only=1
DAY=""
while read -r _local_ref local_sha _remote_ref _remote_sha; do
	DAY="${DAY}${_local_ref} ${local_sha} ${_remote_ref} ${_remote_sha}
"
	case "$local_sha" in
	0000000000000000000000000000000000000000) ;;
	*) deleting_only=0 ;;
	esac
done
[ "$deleting_only" = "1" ] && exit 0

fail() {
	echo ""
	echo "  \`bun run $1\` failed, so this push would have failed CI."
	echo "  Fix it, or push anyway with --no-verify."
	echo ""
	exit 1
}

ROOT="$(git rev-parse --show-toplevel)"
unset $(git rev-parse --local-env-vars)
LOG="$(mktemp)"
RUNS_BEFORE="$(mktemp)"
trap 'rm -f "$LOG" "$RUNS_BEFORE"' EXIT
ls -1 "$ROOT/.turbo/runs" 2>/dev/null >"$RUNS_BEFORE" || true

PHAN_LOAI="$ROOT/scripts/pre-push-t1.mjs"
BO_QUA=""
if [ -f "$PHAN_LOAI" ]; then
	BO_QUA="$(printf '%s' "$DAY" | node "$PHAN_LOAI" --remote "${1:-origin}")" || BO_QUA=""
else
	echo "pre-push: không phân loại được lần đẩy (thiếu scripts/pre-push-t1.mjs) — chạy đủ năm bước."
fi

export TURBO_FORCE=true
export TURBO_RUN_SUMMARY=true

for task in check-types lint lint:slop test build; do
	case " ${BO_QUA:-} " in *" $task "*) continue ;; esac
	echo "pre-push: bun run $task" | tee -a "$LOG"
	bun run "$task" 2>&1 | tee -a "$LOG" || fail "$task"
done

if [ -n "$BO_QUA" ]; then
	bun "$ROOT/scripts/verify-gate-shape.mjs" --log "$LOG" --runs-before "$RUNS_BEFORE" --bo-qua "$BO_QUA"
else
	bun "$ROOT/scripts/verify-gate-shape.mjs" --log "$LOG" --runs-before "$RUNS_BEFORE"
fi
