#!/usr/bin/env bash

set -euo pipefail

if [ -n "${CRM_SKIP_HOOKS:-}" ]; then
	echo "pre-push: CRM_SKIP_HOOKS is set, so nothing was checked before this push."
	exit 0
fi

deleting_only=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
	case "$local_sha" in
	0000000000000000000000000000000000000000) ;;
	*) deleting_only=0 ;;
	esac
done
[ "$deleting_only" = "1" ] && exit 0

fail() {
	echo ""
	echo "  \`bun run $1\` failed, so this push would have failed CI."
	echo "  Fix it, or push anyway with --no-verify."
	echo ""
	exit 1
}

ROOT="$(git rev-parse --show-toplevel)"
LOG="$(mktemp)"
RUNS_BEFORE="$(mktemp)"
trap 'rm -f "$LOG" "$RUNS_BEFORE"' EXIT
ls -1 "$ROOT/.turbo/runs" 2>/dev/null >"$RUNS_BEFORE" || true

export TURBO_FORCE=true
export TURBO_RUN_SUMMARY=true

for task in check-types lint lint:slop test build test:dieu-phoi; do
	echo "pre-push: bun run $task" | tee -a "$LOG"
	bun run "$task" 2>&1 | tee -a "$LOG" || fail "$task"
done

bun "$ROOT/scripts/verify-gate-shape.mjs" --log "$LOG" --runs-before "$RUNS_BEFORE"
