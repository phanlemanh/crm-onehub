{
	"name": "agent",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"license": "MIT",
	"scripts": {
		"backfill:facts": "bun scripts/backfill-empty-facts.ts",
		"backfill:images": "bun scripts/backfill-brand-images.ts",
		"zalo:poll": "bun scripts/zalo-poll.ts",
		"zalo:webhook": "bun scripts/zalo-webhook.ts",
		"dev": "eve dev",
		"dev:headless": "eve dev --no-ui",
		"dispatch": "curl -fsS -X POST \"${AGENT_URL:-http://127.0.0.1:2000}/eve/v1/dev/schedules/dispatch\"",
		"build": "eve build",
		"start": "bun scripts/start.ts",
		"check-types": "tsc --noEmit",
		"test": "CRM_TELEMETRY_DISABLED=1 bun test",
		"eval": "CRM_TELEMETRY_DISABLED=1 eve eval",
		"lint": "biome check .",
		"clean": "rm -rf .turbo .eve node_modules"
	},
	"dependencies": {
		"@ai-sdk/gateway": "4.0.69",
		"@crm/ai-okr": "workspace:*",
		"@crm/db": "workspace:*",
		"@crm/env": "workspace:*",
		"@crm/telemetry": "workspace:*",
		"@crm/validation": "workspace:*",
		"@vercel/oidc": "3.2.0",
		"ai": "^7.0.85",
		"context.dev": "2.10.0",
		"eve": "^0.29.4",
		"mammoth": "1.13.0",
		"unpdf": "1.8.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@crm/typescript-config": "workspace:*",
		"@pdf-lib/fontkit": "1.1.1",
		"@types/node": "^24.0.0",
		"just-bash": "^3.2.0",
		"microsandbox": "^0.6.8",
		"pdf-lib": "1.17.1",
		"typescript": "^5.9.2"
	}
}
